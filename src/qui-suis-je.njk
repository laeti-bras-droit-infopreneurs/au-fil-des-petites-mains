---
layout: base.njk
permalink: qui-suis-je.html
nav_active: qui-suis-je
title: Qui suis-je ? | Au Fil des Petites Mains
description: "Aurélia, artisane couturière installée à Campagne en Périgord Noir depuis juillet 2022. Titulaire d'un CAP Métiers de la Mode Vêtements Flous, artisane et Répar-actrice labellisée."
---
<section class="page-head">
  <div class="container">
    <h1>{{ quisuisje.titre }}</h1>
    <span class="script">{{ quisuisje.entete_script }}</span>
  </div>
</section>

<section class="section">
  <div class="container" style="max-width:880px">
    <h2 class="center">{{ quisuisje.intro_titre }}</h2>

    <div class="portrait">
      {% if quisuisje.image %}
      <img class="portrait__img" src="{{ quisuisje.image }}" alt="Aurélia Bordier, artisane couturière">
      {% endif %}
      {% for p in quisuisje.paragraphes %}
      <p>{{ p }}</p>
      {% endfor %}
    </div>

    {% if quisuisje.citation %}
    <p class="citation script">{{ quisuisje.citation }}</p>
    {% endif %}

    {% for p in quisuisje.paragraphes_suite %}
    <p>{{ p }}</p>
    {% endfor %}

    {% if quisuisje.signature %}
    <p class="signature script">{{ quisuisje.signature }}</p>
    {% endif %}

    <div class="box box--pink">
      <h3>{{ quisuisje.engagements_titre }}</h3>
      <ul class="info-list">
        {% for e in quisuisje.engagements %}<li>{{ e }}</li>
        {% endfor %}
      </ul>
    </div>

    <div class="center" style="margin-top:28px"><a class="btn" href="contact.html">Me contacter</a></div>
  </div>
</section>
