---
layout: base.njk
permalink: broderie.html
nav_active: broderie
title: Broderies numériques personnalisées | Au Fil des Petites Mains
description: "Broderie numérique personnalisée en Dordogne : polos, t-shirts, casquettes, tabliers, serviettes. Pour les professionnels comme pour les particuliers, un cadeau unique et sur mesure."
---
<section class="page-head">
  <div class="container">
    <h1>{{ broderie.titre }}</h1>
    <span class="script">{{ broderie.entete_script }}</span>
  </div>
</section>

<section class="section">
  <div class="container split split--reverse">
    <div class="split__img"><img src="{{ broderie.image }}" alt="Broderie numérique personnalisée"></div>
    <div>
      <h2>{{ broderie.intro_titre }}</h2>
      <p>{{ broderie.intro_texte }}</p>
      {% for a in broderie.atouts %}
      <h3 class="atout__titre">{{ a.titre }}</h3>
      <p>{{ a.texte }}</p>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Galerie professionnels -->
{% if broderie.galerie_pro.length %}
<section class="section section--cream">
  <div class="container">
    <div class="center" style="margin-bottom:34px">
      <h2>{{ broderie.galerie_pro_titre }}</h2>
      <p class="lead" style="max-width:720px;margin:0 auto">{{ broderie.galerie_pro_texte }}</p>
    </div>
    <div class="galerie">
      {% for item in broderie.galerie_pro %}
      <figure class="galerie__item">
        <img src="{{ item.image }}" alt="{{ item.legende }}" loading="lazy">
        <figcaption>{{ item.legende }}</figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- Galerie particuliers -->
{% if broderie.galerie_cadeau.length %}
<section class="section">
  <div class="container">
    <div class="center" style="margin-bottom:34px">
      <h2>{{ broderie.galerie_cadeau_titre }}</h2>
      <p class="lead" style="max-width:720px;margin:0 auto">{{ broderie.galerie_cadeau_texte }}</p>
    </div>
    <div class="galerie">
      {% for item in broderie.galerie_cadeau %}
      <figure class="galerie__item">
        <img src="{{ item.image }}" alt="{{ item.legende }}" loading="lazy">
        <figcaption>{{ item.legende }}</figcaption>
      </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<!-- Tarifs -->
<section class="section section--pink">
  <div class="container">
    <div class="center" style="margin-bottom:30px">
      <h2>{{ broderie.tarifs_titre }}</h2>
    </div>
    <div class="box" style="max-width:820px;margin:0 auto">
      <ul class="info-list">
        {% for t in broderie.tarifs %}<li>{{ t }}</li>
        {% endfor %}
      </ul>
      <p>{{ broderie.tarifs_exemple }}</p>
      <p style="margin-bottom:0"><strong>{{ broderie.tarifs_contact }}</strong></p>
    </div>
    <div class="center" style="margin-top:28px"><a class="btn" href="contact.html">Demander un devis</a></div>
  </div>
</section>
