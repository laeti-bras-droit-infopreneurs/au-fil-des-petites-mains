---
layout: base.njk
permalink: contact.html
nav_active: contact
title: Contact | Au Fil des Petites Mains — Campagne, Dordogne
description: "Contactez Au Fil des Petites Mains à Campagne (24260), Dordogne. Sur rendez-vous du lundi au samedi. Téléphone 06 07 77 38 86."
---
<section class="page-head">
  <div class="container">
    <span class="script">{{ contact.entete_script }}</span>
    <h1>{{ contact.titre }}</h1>
  </div>
</section>

<section class="section">
  <div class="container contact-grid">
    <div class="contact-card">
      <h2>{{ site.nom }}</h2>
      <p><strong>{{ site.proprietaire }}</strong><br>
      {{ site.adresse_ligne1 }}<br>
      {{ site.adresse_ligne2 }}</p>
      <p>✉ <a href="mailto:{{ site.email }}">{{ site.email }}</a><br>
      ☎ <a href="tel:{{ site.telephone_lien }}">{{ site.telephone }}</a></p>

      <div class="box box--pink">
        <h3 style="color:var(--aubergine)">Horaires d'ouverture</h3>
        <p style="margin:2px 0"><em>{{ site.horaires_note }}.</em></p>
        <p style="margin:2px 0">{{ site.horaires_semaine }}</p>
        <p style="margin:2px 0">{{ site.horaires_samedi }}</p>
      </div>

      <p style="margin-top:16px">
        <a href="{{ site.instagram }}" target="_blank" rel="noopener">Instagram</a> ·
        <a href="{{ site.facebook }}" target="_blank" rel="noopener">Facebook</a>
      </p>
    </div>

    <div>
      <h2>{{ contact.formulaire_titre }}</h2>
      <!-- Formulaire Tally (les réponses arrivent dans le compte Tally) -->
      <iframe data-tally-src="https://tally.so/embed/q49qb8?alignLeft=1&hideTitle=1&transparentBackground=1&dynamicHeight=1" loading="lazy" width="100%" height="747" frameborder="0" marginheight="0" marginwidth="0" title="Contact - Au Fil des Petites Mains"></iframe>
      <script>var d=document,w="https://tally.so/widgets/embed.js",v=function(){"undefined"!=typeof Tally?Tally.loadEmbeds():d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach((function(e){e.src=e.dataset.tallySrc}))};if("undefined"!=typeof Tally)v();else if(d.querySelector('script[src="'+w+'"]')==null){var s=d.createElement("script");s.src=w,s.onload=v,s.onerror=v,d.body.appendChild(s);}</script>
    </div>
  </div>
</section>

<section class="section section--pink">
  <div class="container center">
    <span class="script" style="font-size:1.7rem">{{ contact.carte_script }}</span>
    <h2>{{ contact.carte_titre }}</h2>
    <p class="lead" style="max-width:640px;margin:0 auto 26px">{{ contact.carte_texte }}</p>
    {% set lat = contact.carte_latitude %}
    {% set lon = contact.carte_longitude %}
    <div class="box" style="padding:0;overflow:hidden">
      <iframe
        title="Carte — atelier Au Fil des Petites Mains à Campagne, Dordogne"
        src="https://www.openstreetmap.org/export/embed.html?bbox={{ lon - 0.012 }}%2C{{ lat - 0.006 }}%2C{{ lon + 0.012 }}%2C{{ lat + 0.006 }}&layer=mapnik&marker={{ lat }}%2C{{ lon }}"
        style="width:100%;height:360px;border:0" loading="lazy"></iframe>
    </div>
    <p style="margin-top:18px">
      <a class="btn btn--ghost" href="https://www.google.com/maps/search/?api=1&query={{ lat }}%2C{{ lon }}" target="_blank" rel="noopener">Itinéraire avec Google Maps</a>
    </p>
  </div>
</section>
