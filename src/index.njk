---
layout: base.njk
permalink: index.html
nav_active: accueil
title: Au Fil des Petites Mains | Couturière Le Bugue, Campagne, Siorac, Saint Cyprien
description: "Entrez dans l'univers de la couture avec Au Fil des Petites Mains situé en Dordogne, entre Le Bugue, Saint Cyprien et Siorac. Retouches, broderies numériques personnalisées sur mesure pour professionnels ou particuliers, et cours de couture adaptés à tous les niveaux et âges."
---
<!-- Hero -->
<section class="hero hero--photo">
  {% if accueil.hero_image %}
  <div class="hero__photo">
    <img src="{{ accueil.hero_image }}" alt="Aurélia devant son atelier de couture Au Fil des Petites Mains à Campagne, en Dordogne" fetchpriority="high">
  </div>
  {% endif %}
  <div class="container">
    <div class="hero__text">
      <h1>{{ accueil.hero_titre }}</h1>
      <span class="script hero__accroche">{{ accueil.hero_script }}</span>
      <p class="lead">{{ accueil.hero_texte1 }}</p>
      <p class="lead">{{ accueil.hero_texte2 }}</p>
      <p class="lead">{{ accueil.hero_texte3 }}</p>
      <div class="hero__actions">
        <a class="btn" href="contact.html">Me contacter</a>
        <a class="btn btn--ghost" href="#services">Mes services</a>
      </div>
    </div>
  </div>
</section>

<!-- Horaires -->
<div class="hours">
  <div class="container">
    <h3>Horaires d'ouverture</h3>
    <p class="rdv">{{ site.horaires_note }}</p>
    <p>{{ site.horaires_semaine }} &nbsp;•&nbsp; {{ site.horaires_samedi }}</p>
  </div>
</div>

<!-- Services -->
<section class="section" id="services">
  <div class="container">
    <div class="center" style="margin-bottom:44px">
      <h2>{{ accueil.services_titre }}</h2>
    </div>
    <div class="cards">
      {% for s in accueil.services %}
      <a class="card card--lien" href="{{ s.lien }}">
        <img src="{{ s.image }}" alt="{{ s.titre }}">
        <div class="card__body">
          <h3 class="card__titre">{{ s.titre }}</h3>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<!-- Agenda -->
<section class="section section--pink">
  <div class="container">
    <h2 class="titre-orne">{{ accueil.agenda_titre }}</h2>
    <div class="agenda">
      {% if accueil.agenda_image %}
      <div class="agenda__img">
        <img src="{{ accueil.agenda_image }}" alt="Affiche des cours de couture à Campagne">
      </div>
      {% endif %}
      <div class="agenda__texte">
        {% for ligne in accueil.agenda_lignes %}
        <p class="agenda__ligne{% if ligne.souligne %} agenda__ligne--fort{% endif %}">{{ ligne.texte }}</p>
        {% endfor %}
        {% if accueil.agenda_note %}
        <p class="agenda__note">{{ accueil.agenda_note }}</p>
        {% endif %}
        <a class="btn" href="cours.html">Découvrir les cours</a>
      </div>
    </div>
  </div>
</section>

<!-- Labels -->
<section class="section">
  <div class="container center">
    <h2>{{ accueil.labels_titre }}</h2>
    <p class="lead" style="max-width:760px;margin:0 auto 34px">{{ accueil.labels_texte }}</p>
    <div class="labels">
      <img src="assets/img/label-artisan.png" alt="Label Artisan">
      <img src="assets/img/label-bonus.png" alt="Bonus Réparation">
      <img src="assets/img/label-reparacteur.png" alt="Réparateur labellisé Refashion">
    </div>
  </div>
</section>
