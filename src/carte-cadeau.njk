---
layout: base.njk
permalink: carte-cadeau.html
nav_active: carte-cadeau
title: Carte cadeau | Au Fil des Petites Mains
description: "Offrez une carte cadeau Au Fil des Petites Mains : retouches, broderies personnalisées ou cours de couture. Un cadeau original et local en Dordogne."
---
<section class="page-head">
  <div class="container">
    <h1>{{ cartecadeau.titre }}</h1>
    <span class="script">{{ cartecadeau.entete_script }}</span>
  </div>
</section>

<section class="section">
  <div class="container split">
    <div class="split__img"><img src="{{ cartecadeau.image }}" alt="Carte cadeau Au Fil des Petites Mains"></div>
    <div>
      <h2>{{ cartecadeau.intro_titre }}</h2>
      <p>{{ cartecadeau.intro_texte }}</p>

      <h3 class="atout__titre">{{ cartecadeau.montants_titre }}</h3>
      <ul class="montants">
        {% for m in cartecadeau.montants %}
        <li class="price-tag">{{ m }}</li>
        {% endfor %}
      </ul>

      <p>{{ cartecadeau.note }}</p>
      <a class="btn" href="contact.html">Commander une carte cadeau</a>
    </div>
  </div>
</section>
