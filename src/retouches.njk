---
layout: base.njk
permalink: retouches.html
nav_active: retouches
title: Retouches | Au Fil des Petites Mains — Couturière en Dordogne
description: "Un service de retouches sur mesure à Campagne (Dordogne) : ourlets, pinces, réparations, pose de fermetures éclair. Répar-acteur labellisé, bénéficiez du Bonus Réparation."
---
<section class="page-head">
  <div class="container">
    <span class="script">{{ retouches.entete_script }}</span>
    <h1>{{ retouches.titre }}</h1>
  </div>
</section>

<section class="section">
  <div class="container split">
    <div class="split__img"><img src="{{ retouches.image }}" alt="{{ retouches.titre }}"></div>
    <div>
      <h2>{{ retouches.intro_titre }}</h2>
      <p>{{ retouches.intro_texte1 }}</p>
      <p>{{ retouches.intro_texte2 }}</p>
      <ul class="info-list">
        {% for p in retouches.prestations %}<li>{{ p }}</li>
        {% endfor %}
      </ul>
      <a class="btn" href="contact.html">Prendre rendez-vous</a>
    </div>
  </div>
</section>

<section class="section section--cream">
  <div class="container">
    <div class="center" style="margin-bottom:30px">
      <span class="script" style="font-size:1.7rem">{{ retouches.tarifs_script }}</span>
      <h2>{{ retouches.tarifs_titre }}</h2>
    </div>

    <div class="tarifs" data-tarifs>
      <div class="tarifs__search">
        <label class="sr-only" for="recherche-tarifs">Rechercher une prestation</label>
        <input id="recherche-tarifs" type="search" placeholder="Rechercher…" data-tarifs-search autocomplete="off">
      </div>
      <div class="tarifs__scroll">
        <table class="tarifs__table">
          <thead>
            <tr>
              <th scope="col">Prestations</th>
              <th scope="col" class="tarifs__col-prix">Tarifs</th>
            </tr>
          </thead>
          <tbody>
            {% for ligne in retouches.tarifs %}
            <tr>
              <td>{{ ligne.prestation }}</td>
              <td class="tarifs__col-prix">{{ ligne.tarif }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      <p class="tarifs__vide" data-tarifs-empty hidden>Aucune prestation ne correspond à votre recherche.</p>
    </div>

    {% if retouches.tarifs_note %}
    <p class="center" style="max-width:720px;margin:22px auto 0;color:var(--muted);font-size:.95rem">{{ retouches.tarifs_note }}</p>
    {% endif %}
  </div>
</section>

<section class="section section--pink">
  <div class="container center">
    <span class="script" style="font-size:1.7rem">{{ retouches.bonus_script }}</span>
    <h2>{{ retouches.bonus_titre }}</h2>
    <p class="lead" style="max-width:760px;margin:0 auto 30px">{{ retouches.bonus_texte }}</p>
    <div class="labels">
      <img src="assets/img/label-bonus.png" alt="Bonus Réparation">
      <img src="assets/img/label-reparacteur.png" alt="Réparateur labellisé Refashion">
    </div>
  </div>
</section>

<section class="section">
  <div class="container center">
    <h2>{{ retouches.atelier_titre }}</h2>
    <p class="lead" style="max-width:680px;margin:0 auto">{{ retouches.atelier_texte }}</p>
    <div style="margin-top:24px"><a class="btn" href="contact.html">Me contacter</a></div>
  </div>
</section>
